{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=reviewit;Username=postgres;Password=postgres"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Discogs": {
    "BaseUrl": "https://api.discogs.com",
    "UserAgent": "reviewit-app/1.0",
    "DefaultPageSize": 10,
    "MaxPageSize": 50
  },
  "Jwt": {
    "Issuer": "review-it-user-service",
    "Audience": "review-it-api",
    "TokenExpirationInMinutes": 15
  }
}
